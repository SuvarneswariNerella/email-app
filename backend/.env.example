# Server Port
PORT=4000
CLIENT_URL=http://localhost:3000

# Organization IMAP Configuration (Incoming Mail)
IMAP_HOST=mail.yourcompany.com
IMAP_PORT=993
IMAP_SECURE=true

# Organization SMTP Configuration (Outgoing Mail)
SMTP_HOST=mail.yourcompany.com
SMTP_PORT=587
SMTP_SECURE=false

# Session Encryption Key
JWT_SECRET=super_secret_corporate_jwt_key_change_me
